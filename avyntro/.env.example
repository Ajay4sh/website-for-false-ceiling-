# Copy to .env.local and fill in. Never commit real values.

# --- Site ---------------------------------------------------------------
# Production origin, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
# Leave empty until the domain is confirmed; the site then marks itself noindex.
NEXT_PUBLIC_SITE_URL=

# Application sign-in URL. The "Sign in" link appears only when this is set.
NEXT_PUBLIC_APP_SIGNIN_URL=

# "true" shows a visible marker on every piece of content that is still awaiting
# product/legal verification (see src/content). Set to "false" only after review.
NEXT_PUBLIC_CONTENT_REVIEW=true

# --- Demo / contact form delivery (server-side only) -------------------------
# Choose one: "webhook" (POST JSON to your CRM/automation endpoint) or "resend" (email via Resend API).
# If unset or misconfigured, the form returns an honest error and never shows success.
DEMO_DELIVERY=

# webhook mode
DEMO_WEBHOOK_URL=
# Optional shared secret sent as the X-Avyntro-Signature header (HMAC-SHA256 of the body).
DEMO_WEBHOOK_SECRET=

# resend mode
RESEND_API_KEY=
DEMO_NOTIFY_TO=
DEMO_NOTIFY_FROM=

# Rate limit: max submissions per IP per window (in-memory, per server instance).
DEMO_RATE_LIMIT_MAX=5
DEMO_RATE_LIMIT_WINDOW_SECONDS=600
