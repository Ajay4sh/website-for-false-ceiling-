{
  "name": "whatsapp-booking-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Hindi/Hinglish AI assistant for local businesses: answers WhatsApp enquiries, books appointments, follows up missed calls, with a dashboard for owners.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "chat": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/cli.js",
    "manage": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/manage.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "express": "^5.2.1"
  }
}
