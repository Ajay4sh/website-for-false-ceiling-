# Copy this file to .env and fill in the values. Never commit .env.

# ---- Required ----

# Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Encrypts saved WhatsApp tokens. Generate once with: npm run manage -- gen-key
# Keep a copy somewhere safe: without it, saved tokens can't be read.
APP_ENCRYPTION_KEY=

# The public HTTPS address of this server, e.g. https://bot.yourdomain.in
PUBLIC_URL=
# Domain only, for the HTTPS proxy in deploy/ (e.g. bot.yourdomain.in)
DOMAIN=

# WhatsApp Cloud API (Meta developer dashboard)
# A permanent System User token with access to your clients' WhatsApp numbers
WHATSAPP_TOKEN=
# Any secret word you choose; enter the same word in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret; proves webhooks really come from Meta
WHATSAPP_APP_SECRET=

# ---- Optional ----

# Name shown in the dashboard
PRODUCT_NAME=BookBot
# Claude model (default: claude-opus-5-5)
CLAUDE_MODEL=
WHATSAPP_API_VERSION=v23.0
# Google service account JSON for calendar sync (see docs/setup.md)
GOOGLE_SERVICE_ACCOUNT_FILE=
# Database file (the Docker setup sets this for you)
DB_FILE=data/bookbot.db
PORT=3000
# Set to true when running behind the HTTPS proxy (the Docker setup sets this)
TRUST_PROXY=false
