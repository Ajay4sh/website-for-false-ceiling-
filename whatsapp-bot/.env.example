# Copy this file to .env and fill in the values. Never commit .env.

# Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=
# Optional: Claude model to use (default: claude-opus-5-5)
CLAUDE_MODEL=

# Which business this bot serves (a file in businesses/)
BUSINESS_FILE=businesses/ceilcraft.json

# Where bookings, leads and chat history are saved
DATA_DIR=data

# WhatsApp Cloud API (Meta developer dashboard > WhatsApp > API setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Any secret word you choose; enter the same word in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Meta app secret (App settings > Basic); used to check messages really come from Meta
WHATSAPP_APP_SECRET=

PORT=3000
