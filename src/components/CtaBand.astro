---
import { phoneHref, waHref } from '../lib/site';
interface Props { title?: string; text?: string }
const { title = 'Planning a ceiling or wall makeover?', text = 'Book a free site visit. We measure, advise and give you a clear quote.' } = Astro.props;
---
<section class="cta-band">
  <div class="container cta-band__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-band__actions">
      <a href={phoneHref} class="btn">Call Now</a>
      <a href={waHref()} class="btn btn--wa" target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </div>
</section>
