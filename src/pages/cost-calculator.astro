---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Calculator from '../components/Calculator.astro';
import CtaBand from '../components/CtaBand.astro';
import { settings } from '../lib/site';
const crumbs = [{ name: 'Cost Calculator', href: '/cost-calculator/' }];
const tables = [
  { label: 'Ceilings', rows: settings.rates.filter((r) => r.appliesTo !== 'Wall') },
  { label: 'Walls & partitions', rows: settings.rates.filter((r) => r.appliesTo === 'Wall') },
].filter((t) => t.rows.length > 0);
// The "Labour only" column appears only when at least one rate has a labour-only price.
const hasLabour = (r: { labourMin?: number | null; labourMax?: number | null }) => Number(r.labourMin) > 0 && Number(r.labourMax) > 0;
const showLabour = settings.rates.some(hasLabour);
---
<Base
  title={`False Ceiling & Wall Panelling Cost per sq ft in ${settings.city}`}
  description={`Estimate your false ceiling, wall panelling, louver, partition or painting cost in ${settings.city}. Per-sq-ft rates for every material.`}
  crumbs={crumbs}
>
  <PageHero title="Interior cost calculator" text="Get a quick budget for your ceiling or wall, and see our indicative per-sq-ft rates for every material." crumbs={crumbs} />
  <section class="section">
    <div class="container estimate">
      <div>
        <h2>Indicative rates</h2>
        <p>Rates are per sq ft for a standard design. <strong>With material</strong> means we supply everything and install it. <strong>Labour only</strong> means you buy the material and we install it. Multi-level designs, special finishes and lighting fixtures are extra.</p>
        {tables.map((t) => (
          <table class="rates">
            <thead><tr><th>{t.label}</th><th>With material</th>{showLabour && <th>Labour only</th>}</tr></thead>
            <tbody>
              {t.rows.map((r) => (
                <tr>
                  <td>{r.material}</td>
                  <td>₹{r.min} – ₹{r.max}</td>
                  {showLabour && <td>{hasLabour(r) ? `₹${r.labourMin} – ₹${r.labourMax}` : 'On request'}</td>}
                </tr>
              ))}
              {t.label === 'Ceilings' && settings.coveRatePerFt > 0 && (
                <tr>
                  <td>Cove LED lighting (per running ft)</td>
                  <td>≈ ₹{settings.coveRatePerFt}</td>
                  {showLabour && <td>{settings.coveLabourRatePerFt ? `≈ ₹${settings.coveLabourRatePerFt}` : 'On request'}</td>}
                </tr>
              )}
            </tbody>
          </table>
        ))}
        <p class="note" style="margin-top:16px">Prices vary with design, brand of material, ceiling height and site conditions. Your exact quote is given after a free site visit.</p>
      </div>
      <Calculator />
    </div>
  </section>
  <section class="section section--alt">
    <div class="container container--narrow prose">
      <h2>What affects the cost?</h2>
      <ul>
        <li><strong>Material:</strong> PVC and grid ceilings and PVC wall panels are the most economical; gypsum and POP are mid-range; wood, WPC, metal and glass are premium.</li>
        <li><strong>Design:</strong> multi-level, curved and cove designs need more framing and labour than a flat ceiling.</li>
        <li><strong>Lighting:</strong> cove strips, profile lights and spotlights are priced separately.</li>
        <li><strong>Wall condition:</strong> damp or uneven walls may need treatment or framing before panelling or wallpaper.</li>
        <li><strong>Room height and access:</strong> very high ceilings need scaffolding.</li>
        <li><strong>Finish:</strong> standard paint vs. textures, wallpaper or special finishes.</li>
      </ul>
    </div>
  </section>
  <CtaBand />
</Base>
