---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The page you are looking for could not be found.">
  <section class="section">
    <div class="container container--narrow" style="text-align:center">
      <h1>Page not found</h1>
      <p>Sorry, that page doesn't exist. Try one of these instead:</p>
      <p><a href="/" class="btn">Home</a> <a href="/services/" class="btn btn--outline">Services</a></p>
    </div>
  </section>
</Base>
