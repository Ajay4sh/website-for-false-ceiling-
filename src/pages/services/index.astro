---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceGroups from '../../components/ServiceGroups.astro';
import Process from '../../components/Process.astro';
import CtaBand from '../../components/CtaBand.astro';
import { settings } from '../../lib/site';
const crumbs = [{ name: 'Services', href: '/services/' }];
---
<Base
  title={`Interior Services: Ceilings, Walls & Partitions in ${settings.city}`}
  description={`False ceilings, wall panelling, WPC louvers, partitions, painting and wall finishes in ${settings.city}. Compare options and book a free site visit.`}
  crumbs={crumbs}
>
  <PageHero title="Our services" text="Ceilings, walls, partitions and finishes, with lighting, all from one team." crumbs={crumbs} />
  <section class="section">
    <div class="container"><ServiceGroups /></div>
  </section>
  <Process />
  <CtaBand />
</Base>
